@using AppView.ViewModels
@model List<HoaDonView>

<h2 class="mb-4 text-primary">
    <i class="fas fa-file-invoice-dollar me-2"></i>Danh sách hóa đơn của bạn
</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i> Bạn chưa có hóa đơn nào.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Mã Hóa Đơn</th>
                    <th>Ngày Tạo</th>
                    <th>Trạng Thái</th>
                    <th>Thanh Toán</th>
                    <th class="text-end">Tổng Tiền</th>
                    <th>Hình Thức TT</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var hd in Model)
                {
                    <tr>
                        <td>
                            <span class="fw-bold text-primary">#@hd.IdHoaDon.ToString().Substring(0, 8)</span>
                        </td>

                        <td>
                            @(hd.NgayTao.HasValue ? hd.NgayTao.Value.ToString("dd/MM/yyyy HH:mm") : "")
                        </td>

                        <td>
                            @if (hd.TrangThaiDonHang == "Đã giao")
                            {
                                <span class="badge bg-success"><i class="fas fa-check-circle me-1"></i>@hd.TrangThaiDonHang</span>
                            }
                            else if (hd.TrangThaiDonHang == "Đang xử lý")
                            {
                                <span class="badge bg-warning text-dark"><i class="fas fa-hourglass-half me-1"></i>@hd.TrangThaiDonHang</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary"><i class="fas fa-box me-1"></i>@hd.TrangThaiDonHang</span>
                            }
                        </td>

                        <td>
                            @if (hd.TrangThaiThanhToan == "Đã thanh toán")
                            {
                                <span class="text-success"><i class="fas fa-check-circle me-1"></i>@hd.TrangThaiThanhToan</span>
                            }
                            else
                            {
                                <span class="text-danger"><i class="fas fa-times-circle me-1"></i>@hd.TrangThaiThanhToan</span>
                            }
                        </td>

                        <td class="text-end text-danger fw-bold">
                            @hd.TongTienSauGiam.ToString("N0") VNĐ
                        </td>

                        <td>
                            <i class="fas fa-credit-card me-1 text-info"></i>@hd.HinhThucTT.TenHinhThucTT
                        </td>

                        <td class="text-center">
                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Details", "HoaDon", new { idHoaDon = hd.IdHoaDon })">
                                <i class="fas fa-eye"></i> Xem
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
